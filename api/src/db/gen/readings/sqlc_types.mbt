// SQL queries
pub let list_readings_by_user_sql : String = "\nSELECT\n  id,\n  user_id,\n  book_id,\n  title,\n  author,\n  status,\n  current_page,\n  total_pages,\n  memo,\n  google_books_id,\n  finished_at,\n  created_at,\n  updated_at\nFROM readings\nWHERE user_id = ?\nORDER BY updated_at DESC"

pub let get_reading_by_id_sql : String = "SELECT\n  id,\n  user_id,\n  book_id,\n  title,\n  author,\n  status,\n  current_page,\n  total_pages,\n  memo,\n  google_books_id,\n  finished_at,\n  created_at,\n  updated_at\nFROM readings\nWHERE id = ? AND user_id = ?\nLIMIT 1"

pub let insert_reading_sql : String = "INSERT INTO readings (\n  id,\n  user_id,\n  book_id,\n  title,\n  author,\n  status,\n  current_page,\n  total_pages,\n  memo,\n  google_books_id,\n  finished_at,\n  created_at,\n  updated_at\n) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)"

pub let update_reading_sql : String = "UPDATE readings\nSET\n  book_id = ?,\n  title = ?,\n  author = ?,\n  status = ?,\n  current_page = ?,\n  total_pages = ?,\n  memo = ?,\n  google_books_id = ?,\n  finished_at = ?,\n  updated_at = ?\nWHERE id = ? AND user_id = ?"

pub let delete_reading_sql : String = "DELETE FROM readings WHERE id = ? AND user_id = ?"

pub let get_stats_counts_sql : String = "SELECT\n  SUM(CASE WHEN status = 'finished' THEN 1 ELSE 0 END) AS finished,\n  SUM(CASE WHEN status = 'reading' THEN 1 ELSE 0 END) AS reading,\n  SUM(CASE WHEN status = 'tsundoku' THEN 1 ELSE 0 END) AS tsundoku\nFROM readings\nWHERE user_id = ?"

pub let get_stats_pages_this_month_sql : String = "SELECT COALESCE(SUM(total_pages), 0) AS pages_this_month\nFROM readings\nWHERE user_id = ?1\n  AND status = 'finished'\n  AND finished_at IS NOT NULL\n  AND finished_at >= ?2\n  AND finished_at < ?3"
