{
  "name": "reading-log-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "bash scripts/build-wasm.sh",
    "build": "npm run build:wasm",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 execute reading-log --local --file=./migrations/0001_init.sql",
    "migrate:remote": "wrangler d1 execute reading-log --remote --file=./migrations/0001_init.sql",
    "typecheck": "tsc --noEmit",
    "test": "npx --yes tsx scripts/verify.mts",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.7.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "typescript": "^5.8.2",
    "wrangler": "^4.130.0"
  }
}
